{
  "viewport": {
    "width": 1920,
    "height": 960
  },
  "scroll": {
    "startY": 0,
    "endY": "auto",
    "step": 320,
    "wheelIntervalMs": 400,
    "initialWaitMs": 2500,
    "waitMs": 900,
    "maxShots": 80
  },
  "capture": {
    "format": "jpeg",
    "quality": 60
  },
  "chrome": {
    "remoteDebuggingPort": 9223
  },
  "output": {
    "dir": "tmp/scroll-captures/{site}"
  },
  "preCapture": {
    "dismissCookieBanner": true
  }
}
