{
  "viewport": {
    "width": 1920,
    "height": 960
  },
  "scroll": {
    "startY": 0,
    "endY": 2400,
    "step": 120,
    "wheelIntervalMs": 200,
    "initialWaitMs": 2500,
    "waitMs": 200,
    "maxShots": 50
  },
  "capture": {
    "format": "jpeg",
    "quality": 60
  },
  "chrome": {
    "remoteDebuggingPort": 9223
  },
  "output": {
    "dir": "tmp/scroll-captures/{site}"
  },
  "preCapture": {
    "dismissCookieBanner": true
  }
}
