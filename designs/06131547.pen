                                        {
                                          "type": "text",
                                          "id": "z3RV0I",
                                          "name": "フレッシュで優しい甘さと酸味も隠し持つ、白色 系ビール。白ワインに似た香りのホップを使用す ることで、上品な仕上がりに。",
                                          "fill": "#333333ff",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "フレッシュで優しい甘さと酸味も隠し持つ、白色\n系ビール。白ワインに似た香りのホップを使用す\nることで、上品な仕上がりに。",
                                          "lineHeight": 1.7999999523162842,
                                          "textAlignVertical": "middle",
                                          "fontFamily": "Inter",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        }
